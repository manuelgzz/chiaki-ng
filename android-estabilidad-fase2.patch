 import android.view.*
 import androidx.lifecycle.LiveData
@@ -93,6 +94,21 @@ class StreamSession(val connectInfo: ConnectInfo, val logManager: LogManager, va
 		}
 	}
 
+	private fun requestVideoFrameRate(surface: Surface)
+	{
+		if(Build.VERSION.SDK_INT < Build.VERSION_CODES.R || !input.preferences.videoMatchRefresh)
+			return
+		try {
+			// A hint to Android, not a forced display mode or an extra frame queue.
+			surface.setFrameRate(connectInfo.videoProfile.maxFPS.toFloat(), Surface.FRAME_RATE_COMPATIBILITY_FIXED_SOURCE)
+			Log.i("StreamSession", "Requested video surface rate: ${connectInfo.videoProfile.maxFPS} fps")
+		} catch(e: IllegalArgumentException) {
+			Log.w("StreamSession", "Display rejected video frame rate hint", e)
+		} catch(e: IllegalStateException) {
+			Log.w("StreamSession", "Surface unavailable for frame rate hint", e)
+		}
+	}
+
 	fun attachToSurfaceView(surfaceView: SurfaceView)
 	{
 		surfaceView.holder.addCallback(object: SurfaceHolder.Callback {
@@ -102,6 +118,7 @@ class StreamSession(val connectInfo: ConnectInfo, val logManager: LogManager, va
 			{
 				val surface = holder.surface
 				this@StreamSession.surface = surface
+				requestVideoFrameRate(surface)
 				session?.setSurface(surface)
 			}
 
