 static void kill_decoder(AndroidChiakiVideoDecoder *decoder)
 {
 	chiaki_mutex_lock(&decoder->codec_mutex);
-	decoder->shutdown_output = true;
+	atomic_store(&decoder->shutdown_output, true);
 	chiaki_mutex_unlock(&decoder->codec_mutex);
 	// The output worker uses finite waits and exits before the codec is freed.
-	// Never join while holding the mutex the worker needs to observe shutdown.
+	// Join outside the input lock; codec storage stays alive until the join returns.
 	if(decoder->output_thread_started)
 	{
 		chiaki_thread_join(&decoder->output_thread, NULL);
@@ -71,7 +84,7 @@ void android_chiaki_video_decoder_set_surface(AndroidChiakiVideoDecoder *decoder
 		return;
 	}
 	chiaki_mutex_lock(&decoder->codec_mutex);
-	decoder->shutdown_output = false;
+	atomic_store(&decoder->shutdown_output, false);
 
 	if(decoder->codec)
 	{
@@ -115,6 +128,17 @@ void android_chiaki_video_decoder_set_surface(AndroidChiakiVideoDecoder *decoder
 	AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, mime);
 	AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, decoder->target_width);
 	AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, decoder->target_height);
+	// A complete compressed access unit must fit in one input buffer.
+	// This is a request; the actual buffer capacity is still checked below.
+	AMediaFormat_setInt32(format, "max-input-size", decoder->target_width * decoder->target_height);
+	if(decoder->low_latency)
+	{
+		// String keys avoid a link dependency on newer NDK symbols. Unsupported
+		// codecs may ignore these hints; successful configure is not proof of support.
+		AMediaFormat_setInt32(format, "low-latency", 1);
+		AMediaFormat_setInt32(format, "priority", 0);
+	}
+	CHIAKI_LOGI(decoder->log, "[android-video] low_latency_requested=%d diagnostics=%d", decoder->low_latency, decoder->diagnostics);
 
 	media_status_t r = AMediaCodec_configure(decoder->codec, format, decoder->window, NULL, 0);
 	if(r != AMEDIA_OK)
@@ -157,51 +181,74 @@ beach:
 bool android_chiaki_video_decoder_video_sample(uint8_t *buf, size_t buf_size, int32_t frames_lost, bool frame_recovered, void *user)
 {
 	bool r = true;
+	uint64_t input_time = chiaki_time_now_monotonic_us();
 	AndroidChiakiVideoDecoder *decoder = user;
 	chiaki_mutex_lock(&decoder->codec_mutex);
 
-	if(!decoder->codec || decoder->shutdown_output)
+	if(!decoder->codec || atomic_load(&decoder->shutdown_output))
 	{
 		r = false;
 		CHIAKI_LOGE(decoder->log, "Received video data, but decoder is not initialized!");
 		goto beach;
 	}
 
-	while(buf_size > 0)
+	if(!buf || !buf_size)
 	{
-		ssize_t codec_buf_index = AMediaCodec_dequeueInputBuffer(decoder->codec, INPUT_BUFFER_TIMEOUT_MS * 1000);
-		if(codec_buf_index < 0)
-		{
-			CHIAKI_LOGE(decoder->log, "Failed to get input buffer");
-			r = false;
-			goto beach;
-		}
-
-		size_t codec_buf_size;
-		uint8_t *codec_buf = AMediaCodec_getInputBuffer(decoder->codec, (size_t)codec_buf_index, &codec_buf_size);
-		if(!codec_buf || codec_buf_size == 0)
-		{
-			r = false;
-			goto beach;
-		}
-		size_t codec_sample_size = buf_size;
-		if(codec_sample_size > codec_buf_size)
-		{
-			//CHIAKI_LOGD(decoder->log, "Sample is bigger than buffer, splitting");
-			codec_sample_size = codec_buf_size;
-		}
-		memcpy(codec_buf, buf, codec_sample_size);
-		media_status_t queue_result = AMediaCodec_queueInputBuffer(decoder->codec, (size_t)codec_buf_index, 0, codec_sample_size, decoder->timestamp_cur++, 0); // timestamp just raised by 1 for maximum realtime
-		if(queue_result != AMEDIA_OK)
-		{
-			CHIAKI_LOGE(decoder->log, "AMediaCodec_queueInputBuffer() failed: %d", (int)queue_result);
-			r = false;
-			goto beach;
-		}
-		buf += codec_sample_size;
-		buf_size -= codec_sample_size;
-
+		r = false;
+		goto beach;
+	}
+	if(decoder->last_input_time)
+	{
+		uint64_t gap = input_time - decoder->last_input_time;
+		uint_fast64_t old_gap = atomic_load(&decoder->input_gap_max_us);
+		while(gap > old_gap && !atomic_compare_exchange_weak(&decoder->input_gap_max_us, &old_gap, gap)) {}
+	}
+	decoder->last_input_time = input_time;
+	uint64_t wait_start = chiaki_time_now_monotonic_us();
+	ssize_t codec_buf_index = AMediaCodec_dequeueInputBuffer(decoder->codec, INPUT_BUFFER_TIMEOUT_MS * 1000);
+	uint64_t wait_us = chiaki_time_now_monotonic_us() - wait_start;
+	// The input callback is serialized by codec_mutex, so it is the only writer
+	// of this maximum except for the output worker's periodic atomic exchange.
+	uint_fast64_t old_max = atomic_load(&decoder->input_wait_max_us);
+	while(wait_us > old_max && !atomic_compare_exchange_weak(&decoder->input_wait_max_us, &old_max, wait_us)) {}
+	if(codec_buf_index < 0)
+	{
+		if(codec_buf_index == -1) // AMEDIACODEC_INFO_TRY_AGAIN_LATER
+			atomic_fetch_add(&decoder->input_timeouts, 1);
+		else
+			atomic_fetch_add(&decoder->queue_errors, 1);
+		r = false;
+		goto beach;
+	}
+	size_t codec_buf_size = 0;
+	uint8_t *codec_buf = AMediaCodec_getInputBuffer(decoder->codec, (size_t)codec_buf_index, &codec_buf_size);
+	if(!codec_buf || buf_size > codec_buf_size)
+	{
+		// Return ownership of the acquired slot. Never split an access unit into
+		// independent frames: that can corrupt decoding and trigger visible recovery.
+		if(AMediaCodec_queueInputBuffer(decoder->codec, (size_t)codec_buf_index, 0, 0, decoder->timestamp_cur, 0) != AMEDIA_OK)
+			atomic_fetch_add(&decoder->queue_errors, 1);
+		atomic_fetch_add(&decoder->oversize_samples, 1);
+		r = false;
+		goto beach;
 	}
+	uint64_t now = chiaki_time_now_monotonic_us();
+	if(!decoder->timestamp_origin)
+		decoder->timestamp_origin = now;
+	uint64_t timestamp = now - decoder->timestamp_origin;
+	if(timestamp <= decoder->timestamp_cur)
+		timestamp = decoder->timestamp_cur + 1;
+	memcpy(codec_buf, buf, buf_size);
+	media_status_t queue_result = AMediaCodec_queueInputBuffer(decoder->codec, (size_t)codec_buf_index, 0, buf_size, timestamp, 0);
+	if(queue_result != AMEDIA_OK)
+	{
+		atomic_fetch_add(&decoder->queue_errors, 1);
+		CHIAKI_LOGE(decoder->log, "AMediaCodec_queueInputBuffer() failed: %d", (int)queue_result);
+		r = false;
+		goto beach;
+	}
+	decoder->timestamp_cur = timestamp;
+	atomic_fetch_add(&decoder->samples_submitted, 1);
 
 beach:
 	chiaki_mutex_unlock(&decoder->codec_mutex);
@@ -211,39 +258,56 @@ beach:
 static void *android_chiaki_video_decoder_output_thread_func(void *user)
 {
 	AndroidChiakiVideoDecoder *decoder = user;
-
-	while(1)
+	uint64_t report_start = chiaki_time_now_monotonic_us();
+	uint64_t last_output = 0, output_count = 0, max_gap = 0, long_gaps = 0;
+	uint64_t release_errors = 0;
+	uint64_t gap_threshold_us = 1500000 / (decoder->target_fps ? decoder->target_fps : 60);
+	while(!atomic_load(&decoder->shutdown_output))
 	{
-		chiaki_mutex_lock(&decoder->codec_mutex);
-		bool stopping = decoder->shutdown_output;
-		chiaki_mutex_unlock(&decoder->codec_mutex);
-		if(stopping)
-			break;
+		// Do not acquire codec_mutex here: input may be waiting for a free buffer.
+		// Shutdown joins this worker before stopping or deleting the codec.
 		AMediaCodecBufferInfo info;
 		ssize_t status = AMediaCodec_dequeueOutputBuffer(decoder->codec, &info, 10000);
 		if(status >= 0)
 		{
-			AMediaCodec_releaseOutputBuffer(decoder->codec, (size_t)status, info.size != 0);
-			if(info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM)
+			bool render = info.size != 0 && !(info.flags & AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG);
+			media_status_t result = AMediaCodec_releaseOutputBuffer(decoder->codec, (size_t)status, render);
+			if(result != AMEDIA_OK)
+				release_errors++;
+			if(render && result == AMEDIA_OK)
 			{
-				CHIAKI_LOGI(decoder->log, "AMediaCodec reported EOS");
-				break;
+				uint64_t now = chiaki_time_now_monotonic_us();
+				if(last_output)
+				{
+					uint64_t gap = now - last_output;
+					if(gap > max_gap) max_gap = gap;
+					if(gap > gap_threshold_us) long_gaps++;
+				}
+				last_output = now;
+				output_count++;
 			}
+			if(info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM)
+				break;
 		}
-		else
+		uint64_t now = chiaki_time_now_monotonic_us();
+		if(decoder->diagnostics && now - report_start >= 5000000)
 		{
-			chiaki_mutex_lock(&decoder->codec_mutex);
-			bool shutdown = decoder->shutdown_output;
-			chiaki_mutex_unlock(&decoder->codec_mutex);
-			if(shutdown)
-			{
-				CHIAKI_LOGI(decoder->log, "Video Decoder Output Thread detected shutdown after reported error");
-				break;
-			}
+			CHIAKI_LOGI(decoder->log, "[android-video] window_ms=%" PRIu64 " output=%" PRIu64
+				" max_output_gap_us=%" PRIu64 " gaps_over_threshold=%" PRIu64 " gap_threshold_us=%" PRIu64
+				" submitted=%" PRIuFAST64 " input_timeouts=%" PRIuFAST64
+				" queue_errors=%" PRIuFAST64 " invalid_or_oversize=%" PRIuFAST64
+				" max_input_wait_us=%" PRIuFAST64 " max_input_gap_us=%" PRIuFAST64 " release_errors=%" PRIu64,
+				(now - report_start) / 1000, output_count, max_gap, long_gaps, gap_threshold_us,
+				atomic_exchange(&decoder->samples_submitted, 0),
+				atomic_exchange(&decoder->input_timeouts, 0),
+				atomic_exchange(&decoder->queue_errors, 0),
+				atomic_exchange(&decoder->oversize_samples, 0),
+				atomic_exchange(&decoder->input_wait_max_us, 0),
+				atomic_exchange(&decoder->input_gap_max_us, 0), release_errors);
+			report_start = now;
+			output_count = max_gap = long_gaps = release_errors = 0;
 		}
 	}
-
 	CHIAKI_LOGI(decoder->log, "Video Decoder Output Thread exiting");
-
 	return NULL;
-}
\ No newline at end of file
+}
