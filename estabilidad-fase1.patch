+// Count each dropped frame once. The caller advances frame_index_prev after
+// finishing a frame; completely absent frames are counted at the next arrival.
+static void count_lost_frames(ChiakiVideoReceiver *video_receiver, uint16_t count)
+{
+	chiaki_mutex_lock(&video_receiver->frames_lost_mutex);
+	video_receiver->frames_lost += count > INT32_MAX - video_receiver->frames_lost
+		? INT32_MAX - video_receiver->frames_lost : count;
+	video_receiver->frames_lost_total += count > INT32_MAX - video_receiver->frames_lost_total
+		? INT32_MAX - video_receiver->frames_lost_total : count;
+	chiaki_mutex_unlock(&video_receiver->frames_lost_mutex);
+}
