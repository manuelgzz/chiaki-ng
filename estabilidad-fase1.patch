+CHIAKI_EXPORT ChiakiErrorCode chiaki_video_receiver_request_idr(ChiakiVideoReceiver *video_receiver)
+{
+	chiaki_mutex_lock(&video_receiver->waiting_for_idr_mutex);
+	ChiakiErrorCode err = CHIAKI_ERR_SUCCESS;
+	if(!video_receiver->waiting_for_idr)
+	{
+		video_receiver->waiting_for_idr = true;
+		video_receiver->idr_wait_start_us = chiaki_time_now_monotonic_us();
+		video_receiver->idr_last_request_us = video_receiver->idr_wait_start_us;
+		video_receiver->idr_request_attempts = 1;
+		// Hold the recovery lock through submission so a fast IDR cannot be
+		// consumed before the waiting state is established.
+		err = stream_connection_send_idr_request(&video_receiver->session->stream_connection);
+	}
+	chiaki_mutex_unlock(&video_receiver->waiting_for_idr_mutex);
+	return err;
+}
+
+CHIAKI_EXPORT void chiaki_video_receiver_poll_recovery(ChiakiVideoReceiver *video_receiver)
+{
+	chiaki_mutex_lock(&video_receiver->waiting_for_idr_mutex);
+	if(video_receiver->waiting_for_idr)
+	{
+		uint64_t now = chiaki_time_now_monotonic_us();
+		if(now - video_receiver->idr_wait_start_us >= IDR_RECOVERY_TIMEOUT_US)
+		{
+			video_receiver->waiting_for_idr = false;
+			CHIAKI_LOGW(video_receiver->log, "IDR recovery timed out; resuming reference-frame recovery");
+		}
+		else if(video_receiver->idr_request_attempts < IDR_MAX_REQUEST_ATTEMPTS
+			&& now - video_receiver->idr_last_request_us >= IDR_RETRY_INTERVAL_US)
+		{
+			video_receiver->idr_last_request_us = now;
+			video_receiver->idr_request_attempts++;
+			ChiakiErrorCode err = stream_connection_send_idr_request(&video_receiver->session->stream_connection);
+			if(err != CHIAKI_ERR_SUCCESS)
+				CHIAKI_LOGW(video_receiver->log, "IDR retry failed: %s", chiaki_error_string(err));
+		}
+	}
+	chiaki_mutex_unlock(&video_receiver->waiting_for_idr_mutex);
+}
