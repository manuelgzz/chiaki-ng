diff --git a/test/packetstats.c b/test/packetstats.c
new file mode 100644
index 0000000..71045cc
--- /dev/null
+++ b/test/packetstats.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include <munit.h>
+#include <chiaki/packetstats.h>
+
+static void expect_stats(ChiakiPacketStats *stats, bool reset, uint64_t expected_received, uint64_t expected_lost)
+{
+	uint64_t received, lost;
+	chiaki_packet_stats_get(stats, reset, &received, &lost);
+	munit_assert_uint64(received, ==, expected_received);
+	munit_assert_uint64(lost, ==, expected_lost);
+}
+
+static MunitResult test_sequences(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiPacketStats stats;
+	munit_assert_int(chiaki_packet_stats_init(&stats), ==, CHIAKI_ERR_SUCCESS);
+	// A high initial sequence number must not imply a startup loss burst.
+	chiaki_packet_stats_push_seq(&stats, 65534);
+	chiaki_packet_stats_push_seq(&stats, 65535);
+	chiaki_packet_stats_push_seq(&stats, 0);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	expect_stats(&stats, true, 4, 0);
+	// Old packets, including duplicates across a reporting boundary, are ignored.
+	chiaki_packet_stats_push_seq(&stats, 0);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	expect_stats(&stats, false, 0, 0);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	chiaki_packet_stats_push_seq(&stats, 4);
+	chiaki_packet_stats_push_seq(&stats, 4);
+	expect_stats(&stats, false, 2, 1);
+	chiaki_packet_stats_push_seq(&stats, 3);
+	expect_stats(&stats, true, 3, 0);
+	chiaki_packet_stats_push_seq(&stats, 7);
+	expect_stats(&stats, true, 1, 2);
+	chiaki_packet_stats_push_seq(&stats, 6);
+	chiaki_packet_stats_push_generation(&stats, 100, 5);
+	expect_stats(&stats, true, 100, 5);
+	expect_stats(&stats, false, 0, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_wrap_loss(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiPacketStats stats;
+	chiaki_packet_stats_init(&stats);
+	chiaki_packet_stats_push_seq(&stats, 65534);
+	expect_stats(&stats, true, 1, 0);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	expect_stats(&stats, false, 1, 2);
+	chiaki_packet_stats_push_seq(&stats, 0);
+	chiaki_packet_stats_push_seq(&stats, 65535);
+	chiaki_packet_stats_push_seq(&stats, 0);
+	expect_stats(&stats, true, 3, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static void *push_sequences(void *user)
+{
+	ChiakiPacketStats *stats = user;
+	for(unsigned int i = 1; i <= 10000; i++)
+		chiaki_packet_stats_push_seq(stats, (ChiakiSeqNum16)i);
+	return NULL;
+}
+
+static MunitResult test_concurrent_reset(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiPacketStats stats;
+	chiaki_packet_stats_init(&stats);
+	ChiakiThread producer;
+	munit_assert_int(chiaki_thread_create(&producer, push_sequences, &stats), ==, CHIAKI_ERR_SUCCESS);
+	uint64_t total_received = 0, total_lost = 0, received, lost;
+	for(unsigned int i = 0; i < 1000; i++)
+	{
+		chiaki_packet_stats_get(&stats, true, &received, &lost);
+		total_received += received;
+		total_lost += lost;
+	}
+	munit_assert_int(chiaki_thread_join(&producer, NULL), ==, CHIAKI_ERR_SUCCESS);
+	chiaki_packet_stats_get(&stats, true, &received, &lost);
+	munit_assert_uint64(total_received + received, ==, 10000);
+	munit_assert_uint64(total_lost + lost, ==, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+MunitTest tests_packet_stats[] = {
+	{ "/sequences", test_sequences, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/wrap_loss", test_wrap_loss, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/concurrent_reset", test_concurrent_reset, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
diff --git a/test/videoreceiver.c b/test/videoreceiver.c
new file mode 100644
index 0000000..574e269
--- /dev/null
+++ b/test/videoreceiver.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// Isolated receiver tests: real frame processing/FEC/bitstream, deterministic
+// clock and transport. No console or network access is needed.
+#include <munit.h>
+#include <chiaki/session.h>
+#include <chiaki/videoreceiver.h>
+#include <string.h>
+#include <limits.h>
+
+static uint64_t now_us;
+static unsigned requests;
+static bool fail_request, reject_sample;
+static int32_t delivered_lost;
+static unsigned delivered;
+static ChiakiLog quiet_log;
+
+uint64_t chiaki_time_now_monotonic_us(void) { return now_us; }
+const char *chiaki_error_string(ChiakiErrorCode err) { (void)err; return "test error"; }
+ChiakiErrorCode stream_connection_send_idr_request(ChiakiStreamConnection *stream)
+{
+	(void)stream; requests++;
+	return fail_request ? CHIAKI_ERR_NETWORK : CHIAKI_ERR_SUCCESS;
+}
+ChiakiErrorCode stream_connection_send_corrupt_frame(ChiakiStreamConnection *stream, ChiakiSeqNum16 start, ChiakiSeqNum16 end)
+{
+	(void)stream; (void)start; (void)end;
+	return CHIAKI_ERR_SUCCESS;
+}
+void chiaki_session_send_event(ChiakiSession *session, ChiakiEvent *event) { (void)session; (void)event; }
+
+static bool sample_cb(uint8_t *buf, size_t size, int32_t lost, bool recovered, void *user)
+{
+	(void)buf; (void)size; (void)recovered; (void)user;
+	delivered_lost = lost; delivered++;
+	return !reject_sample;
+}
+
+static void init_receiver(ChiakiVideoReceiver *receiver, ChiakiSession *session)
+{
+	memset(session, 0, sizeof(*session));
+	chiaki_log_init(&quiet_log, 0, NULL, NULL);
+	session->log = &quiet_log;
+	session->connect_info.video_profile.codec = CHIAKI_CODEC_H264;
+	session->video_sample_cb = sample_cb;
+	chiaki_video_receiver_init(receiver, session, NULL);
+	receiver->profiles_count = 1;
+	receiver->profile_cur = 0;
+	now_us = 1000; requests = delivered = 0;
+	fail_request = reject_sample = false;
+	delivered_lost = -1;
+}
+
+static void send_frame(ChiakiVideoReceiver *receiver, uint16_t index, bool complete)
+{
+	// Source units carry two padding bytes followed by encoded payload.
+	uint8_t data[8] = { 0, 0, 0, 0, 0, 1, 0x09, 0x10 };
+	ChiakiTakionAVPacket packet = { 0 };
+	packet.is_video = true;
+	packet.frame_index = index;
+	packet.units_in_frame_total = complete ? 2 : 3;
+	packet.units_in_frame_fec = 1;
+	packet.unit_index = complete ? 0 : 2;
+	packet.data = data;
+	packet.data_size = sizeof(data);
+	chiaki_video_receiver_av_packet(receiver, &packet);
+}
+
+static MunitResult test_loss_accounting(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiSession session; ChiakiVideoReceiver receiver;
+	init_receiver(&receiver, &session);
+	send_frame(&receiver, 100, true);
+	munit_assert_int(delivered_lost, ==, 0);
+	for(unsigned i=101; i<=103; i++) send_frame(&receiver, i, false);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 3);
+	send_frame(&receiver, 104, true);
+	munit_assert_int(delivered_lost, ==, 3);
+	send_frame(&receiver, 107, true);
+	munit_assert_int(delivered_lost, ==, 2);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 5);
+	// A duplicate or older frame cannot count a loss twice.
+	send_frame(&receiver, 106, false);
+	send_frame(&receiver, 107, true);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 5);
+	reject_sample = true;
+	send_frame(&receiver, 108, true);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 6);
+	reject_sample = false;
+	send_frame(&receiver, 109, true);
+	munit_assert_int(delivered_lost, ==, 1);
+	chiaki_video_receiver_fini(&receiver);
+	return MUNIT_OK;
+}
+
+static MunitResult test_wrap_accounting(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiSession session; ChiakiVideoReceiver receiver;
+	init_receiver(&receiver, &session);
+	send_frame(&receiver, 65534, true);
+	send_frame(&receiver, 65535, false);
+	send_frame(&receiver, 0, false);
+	send_frame(&receiver, 1, true);
+	munit_assert_int(delivered_lost, ==, 2);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 2);
+	// A completely missing frame spanning the wrap is also counted once.
+	chiaki_video_receiver_fini(&receiver);
+	init_receiver(&receiver, &session);
+	send_frame(&receiver, 65534, true);
+	send_frame(&receiver, 1, true);
+	munit_assert_int(delivered_lost, ==, 2);
+	receiver.frames_lost_total = INT32_MAX;
+	send_frame(&receiver, 2, false);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, INT32_MAX);
+	chiaki_video_receiver_fini(&receiver);
+	return MUNIT_OK;
+}
+
+static MunitResult test_bounded_recovery(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiSession session; ChiakiVideoReceiver receiver;
+	init_receiver(&receiver, &session);
+	fail_request = true;
+	munit_assert_int(chiaki_video_receiver_request_idr(&receiver), ==, CHIAKI_ERR_NETWORK);
+	munit_assert_true(chiaki_video_receiver_get_waiting_for_idr(&receiver));
+	for(unsigned i=0; i<50; i++) chiaki_video_receiver_request_idr(&receiver);
+	munit_assert_uint(requests, ==, 1);
+	// A malformed/non-IDR frame must not bypass the recovery gate.
+	send_frame(&receiver, 10, true);
+	munit_assert_uint(delivered, ==, 0);
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 1);
+	now_us += 999999;
+	chiaki_video_receiver_poll_recovery(&receiver);
+	munit_assert_uint(requests, ==, 1);
+	now_us++;
+	fail_request = false;
+	chiaki_video_receiver_poll_recovery(&receiver);
+	munit_assert_uint(requests, ==, 2);
+	now_us += 1000000;
+	chiaki_video_receiver_poll_recovery(&receiver);
+	munit_assert_uint(requests, ==, 3);
+	now_us += 1000000;
+	chiaki_video_receiver_poll_recovery(&receiver);
+	munit_assert_false(chiaki_video_receiver_get_waiting_for_idr(&receiver));
+	munit_assert_uint(requests, ==, 3);
+	send_frame(&receiver, 11, true);
+	munit_assert_uint(delivered, ==, 1);
+	chiaki_video_receiver_request_idr(&receiver);
+	chiaki_video_receiver_set_waiting_for_idr(&receiver, false);
+	now_us += 1000000;
+	chiaki_video_receiver_poll_recovery(&receiver);
+	munit_assert_uint(requests, ==, 4);
+	chiaki_video_receiver_fini(&receiver);
+	return MUNIT_OK;
+}
+
+static MunitResult test_idr_arrival(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	// Existing bitstream fixtures, with source-unit padding prepended.
+	uint8_t h264[] = { 0, 0,
+		0x00, 0x00, 0x00, 0x01, 0x65, 0x88, 0x80, 0x82, 0x1f, 0x00, 0x49, 0xee, 0x03, 0x29, 0xff, 0xf8,
+		0x7f, 0x88, 0x46, 0x44, 0x77, 0x17, 0xe7, 0x6d, 0xb3, 0xad, 0x38, 0x19, 0x74, 0x5a, 0xf1, 0x51 };
+	uint8_t h265[] = { 0, 0,
+		0x00, 0x00, 0x00, 0x01, 0x28, 0x01, 0xac, 0x25, 0xcf, 0x83, 0xff, 0x23, 0x54, 0xab, 0x5c, 0xf5,
+		0x7a, 0x06, 0x7c, 0x3f, 0x31, 0x9b, 0xe6, 0x10, 0x57, 0xe8, 0x0e, 0xcf, 0xdd, 0xda, 0xdb, 0x3f };
+	for(unsigned int codec = 0; codec < 2; codec++)
+	{
+		ChiakiSession session; ChiakiVideoReceiver receiver;
+		init_receiver(&receiver, &session);
+		chiaki_bitstream_init(&receiver.bitstream, &quiet_log, codec ? CHIAKI_CODEC_H265 : CHIAKI_CODEC_H264);
+		if(!codec) receiver.bitstream.h264.sps.log2_max_frame_num_minus4 = 3;
+		receiver.reference_frames[0] = 42;
+		chiaki_video_receiver_request_idr(&receiver);
+		ChiakiTakionAVPacket packet = { 0 };
+		packet.is_video = true; packet.frame_index = 100;
+		packet.units_in_frame_total = 2; packet.units_in_frame_fec = 1;
+		packet.data = codec ? h265 : h264; packet.data_size = sizeof(h264);
+		chiaki_video_receiver_av_packet(&receiver, &packet);
+		munit_assert_false(chiaki_video_receiver_get_waiting_for_idr(&receiver));
+		munit_assert_uint(delivered, ==, 1);
+		munit_assert_int(delivered_lost, ==, 0);
+		for(unsigned int i = 0; i < 16; i++)
+			munit_assert_int(receiver.reference_frames[i], !=, 42);
+		now_us += 1000000;
+		chiaki_video_receiver_poll_recovery(&receiver);
+		munit_assert_uint(requests, ==, 1);
+		chiaki_video_receiver_fini(&receiver);
+	}
+	return MUNIT_OK;
+}
+
+static MunitResult test_fec_recovery_option(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	ChiakiSession session; ChiakiVideoReceiver receiver;
+	init_receiver(&receiver, &session);
+	send_frame(&receiver, 1, false);
+	munit_assert_uint(requests, ==, 0);
+	session.connect_info.enable_idr_on_fec_failure = true;
+	send_frame(&receiver, 2, false);
+	send_frame(&receiver, 3, false);
+	munit_assert_uint(requests, ==, 1);
+	munit_assert_true(chiaki_video_receiver_get_waiting_for_idr(&receiver));
+	munit_assert_int(chiaki_video_receiver_get_frames_lost_total(&receiver), ==, 3);
+	chiaki_video_receiver_fini(&receiver);
+	return MUNIT_OK;
+}
+
+static MunitTest tests[] = {
+	{ "/idr_arrival", test_idr_arrival, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/fec_recovery_option", test_fec_recovery_option, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/loss_accounting", test_loss_accounting, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/wrap_accounting", test_wrap_accounting, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/bounded_recovery", test_bounded_recovery, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
+int main(int argc, char **argv)
+{
+	MunitSuite suite = { "/video_receiver", tests, NULL, 1, MUNIT_SUITE_OPTION_NONE };
+	return munit_suite_main(&suite, NULL, argc, argv);
+}
