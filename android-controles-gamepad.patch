+
+class TouchControlsModeTest {
+    @Test fun autoHideRestoresButtonsOnDisconnect() {
+        assertEquals(TouchControlsMode.FULL, TouchControlsMode.select(true, false, false, true))
+        assertEquals(TouchControlsMode.HIDDEN, TouchControlsMode.select(true, false, true, true))
+        assertEquals(TouchControlsMode.FULL, TouchControlsMode.select(true, false, false, true))
