diff --git a/android/app/src/main/java/com/metallic/chiaki/session/GamepadMapping.kt b/android/app/src/main/java/com/metallic/chiaki/session/GamepadMapping.kt
new file mode 100644
index 0000000..680413e
--- /dev/null
+++ b/android/app/src/main/java/com/metallic/chiaki/session/GamepadMapping.kt
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+package com.metallic.chiaki.session
+
+import android.view.InputDevice
+import android.view.KeyEvent
+import android.view.MotionEvent
+import com.metallic.chiaki.common.Preferences
+import com.metallic.chiaki.lib.ControllerState
+
+/** A saved profile maps Android input sources to PS buttons, independently of touch input. */
+object GamepadMapping {
+    val targets = linkedMapOf(
+        "cross" to "✕", "circle" to "○", "square" to "□", "triangle" to "△",
+        "up" to "↑", "down" to "↓", "left" to "←", "right" to "→",
+        "l1" to "L1", "r1" to "R1", "l2" to "L2", "r2" to "R2",
+        "l3" to "L3", "r3" to "R3", "options" to "Options",
+        "create" to "Create / Share", "ps" to "PS", "touchpad" to "Touchpad"
+    )
+    val axes = listOf(MotionEvent.AXIS_LTRIGGER, MotionEvent.AXIS_RTRIGGER,
+        MotionEvent.AXIS_BRAKE, MotionEvent.AXIS_GAS, MotionEvent.AXIS_HAT_X, MotionEvent.AXIS_HAT_Y)
+    fun key(code: Int) = "key:$code"
+    fun axis(code: Int, sign: Int = 1) = "axis:$code:$sign"
+    fun isGamepad(device: InputDevice?) = device != null && !device.isVirtual &&
+        (device.supportsSource(InputDevice.SOURCE_GAMEPAD) || device.supportsSource(InputDevice.SOURCE_JOYSTICK))
+    fun sourceLabel(source: String): String {
+        val parts = source.split(':')
+        return if(parts[0] == "key") KeyEvent.keyCodeToString(parts[1].toInt()).removePrefix("KEYCODE_")
+        else "${MotionEvent.axisToString(parts[1].toInt()).removePrefix("AXIS_")} ${if(parts[2] == "-1") "−" else "+"}"
+    }
+    fun defaults(swap: Boolean): Map<String, String> = linkedMapOf(
+        key(KeyEvent.KEYCODE_BUTTON_A) to if(swap) "circle" else "cross",
+        key(KeyEvent.KEYCODE_BUTTON_B) to if(swap) "cross" else "circle",
+        key(KeyEvent.KEYCODE_BUTTON_X) to if(swap) "triangle" else "square",
+        key(KeyEvent.KEYCODE_BUTTON_Y) to if(swap) "square" else "triangle",
+        key(KeyEvent.KEYCODE_DPAD_UP) to "up", key(KeyEvent.KEYCODE_DPAD_DOWN) to "down",
+        key(KeyEvent.KEYCODE_DPAD_LEFT) to "left", key(KeyEvent.KEYCODE_DPAD_RIGHT) to "right",
+        key(KeyEvent.KEYCODE_BUTTON_L1) to "l1", key(KeyEvent.KEYCODE_BUTTON_R1) to "r1",
+        key(KeyEvent.KEYCODE_BUTTON_L2) to "l2", key(KeyEvent.KEYCODE_BUTTON_R2) to "r2",
+        key(KeyEvent.KEYCODE_BUTTON_THUMBL) to "l3", key(KeyEvent.KEYCODE_BUTTON_THUMBR) to "r3",
+        key(KeyEvent.KEYCODE_BUTTON_START) to "options", key(KeyEvent.KEYCODE_BUTTON_SELECT) to "create",
+        key(KeyEvent.KEYCODE_BUTTON_MODE) to "ps", key(KeyEvent.KEYCODE_BUTTON_C) to "ps",
+        axis(MotionEvent.AXIS_LTRIGGER) to "l2", axis(MotionEvent.AXIS_BRAKE) to "l2",
+        axis(MotionEvent.AXIS_RTRIGGER) to "r2", axis(MotionEvent.AXIS_GAS) to "r2",
+        axis(MotionEvent.AXIS_HAT_X, -1) to "left", axis(MotionEvent.AXIS_HAT_X) to "right",
+        axis(MotionEvent.AXIS_HAT_Y, -1) to "up", axis(MotionEvent.AXIS_HAT_Y) to "down"
+    )
+    fun load(preferences: Preferences, descriptor: String): Map<String, String> =
+        preferences.gamepadProfile(descriptor)?.mapNotNull {
+            val parts = it.split('=')
+            if(parts.size == 2 && parts[1] in targets) parts[0] to parts[1] else null
+        }?.toMap() ?: defaults(preferences.swapCrossMoon)
+
+    fun save(preferences: Preferences, descriptor: String, mapping: Map<String, String>) =
+        preferences.setGamepadProfile(descriptor, mapping.map { "${it.key}=${it.value}" }.toSet())
+
+    /** Assign both Android representations of a trigger/dpad to avoid duplicate old actions. */
+    fun assign(mapping: Map<String, String>, source: String, target: String): Map<String, String> {
+        val aliases = defaults(false).let { defaults ->
+            val defaultTarget = defaults[source]
+            if(defaultTarget in setOf("l2", "r2", "up", "down", "left", "right"))
+                defaults.filterValues { it == defaultTarget }.keys else setOf(source)
+        }
+        return mapping.filterValues { it != target }.toMutableMap().apply {
+            aliases.forEach { put(it, target) }
+        }
+    }
+
+    fun apply(state: ControllerState, target: String, strength: Float) {
+        val value = strength.coerceIn(0f, 1f)
+        if(target == "l2") { state.l2State = maxOf(state.l2State, (value * 255).toInt().toUByte()); return }
+        if(target == "r2") { state.r2State = maxOf(state.r2State, (value * 255).toInt().toUByte()); return }
+        if(value < 0.5f) return
+        val mask = when(target) {
+            "cross" -> ControllerState.BUTTON_CROSS
+            "circle" -> ControllerState.BUTTON_MOON
+            "square" -> ControllerState.BUTTON_BOX
+            "triangle" -> ControllerState.BUTTON_PYRAMID
+            "up" -> ControllerState.BUTTON_DPAD_UP
+            "down" -> ControllerState.BUTTON_DPAD_DOWN
+            "left" -> ControllerState.BUTTON_DPAD_LEFT
+            "right" -> ControllerState.BUTTON_DPAD_RIGHT
+            "l1" -> ControllerState.BUTTON_L1
+            "r1" -> ControllerState.BUTTON_R1
+            "l3" -> ControllerState.BUTTON_L3
+            "r3" -> ControllerState.BUTTON_R3
+            "options" -> ControllerState.BUTTON_OPTIONS
+            "create" -> ControllerState.BUTTON_SHARE
+            "ps" -> ControllerState.BUTTON_PS
+            "touchpad" -> ControllerState.BUTTON_TOUCHPAD
+            else -> 0U
+        }
+        state.buttons = state.buttons or mask
+    }
+}
+
+/** Rebuild from held sources so releasing one binding cannot release another held binding. */
+class GamepadState(private val mapping: Map<String, String>) {
+    private val held = mutableMapOf<String, Float>()
+    private val analogSources = mutableSetOf<String>()
+    private var sticks = ControllerState()
+    fun key(code: Int, down: Boolean): Boolean {
+        val source = GamepadMapping.key(code)
+        if(source !in mapping) return false
+        if(down) held[source] = 1f else held.remove(source)
+        return true
+    }
+    fun motion(event: MotionEvent) {
+        fun stick(axis: Int) = (event.getAxisValue(axis).coerceIn(-1f, 1f) * Short.MAX_VALUE).toInt().toShort()
+        sticks = ControllerState(leftX = stick(MotionEvent.AXIS_X), leftY = stick(MotionEvent.AXIS_Y),
+            rightX = stick(MotionEvent.AXIS_Z), rightY = stick(MotionEvent.AXIS_RZ))
+        GamepadMapping.axes.forEach { axis ->
+            if(event.device?.getMotionRange(axis, event.source) != null) {
+                axis(axis, event.getAxisValue(axis))
+            }
+        }
+    }
+    internal fun axis(code: Int, rawValue: Float) {
+        for(sign in listOf(-1, 1)) {
+            val source = GamepadMapping.axis(code, sign)
+            val value = (rawValue * sign).coerceIn(0f, 1f)
+            held[source] = if(value < 0.05f) 0f else value
+            analogSources.add(source)
+        }
+    }
+    fun snapshot(): ControllerState = sticks.copy().apply {
+        held.forEach { (source, value) ->
+            val target = mapping[source] ?: return@forEach
+            val analogTrigger = target in setOf("l2", "r2") && source.startsWith("key:") &&
+                source in setOf(GamepadMapping.key(KeyEvent.KEYCODE_BUTTON_L2), GamepadMapping.key(KeyEvent.KEYCODE_BUTTON_R2)) &&
+                analogSources.any { mapping[it] == target && it.endsWith(":1") }
+            if(!analogTrigger) GamepadMapping.apply(this, target, value)
+        }
+    }
+}
