index 0000000..392d458
--- /dev/null
+++ b/android/app/src/main/java/com/metallic/chiaki/settings/GamepadSettingsActivity.kt
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+package com.metallic.chiaki.settings
+
+import android.hardware.input.InputManager
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.InputDevice
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.widget.*
+import androidx.appcompat.app.AppCompatActivity
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.metallic.chiaki.R
+import com.metallic.chiaki.common.Preferences
+import com.metallic.chiaki.session.GamepadMapping
+
+class GamepadSettingsActivity : AppCompatActivity(), InputManager.InputDeviceListener {
+    private lateinit var preferences: Preferences
+    private lateinit var inputManager: InputManager
+    private lateinit var content: LinearLayout
+    private var selectedDescriptor: String? = null
+    private var capture: ((String) -> Unit)? = null
+    private val neutralAxes = mutableSetOf<Int>()
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        title = getString(R.string.gamepad_mapping_title)
+        preferences = Preferences(this)
+        inputManager = getSystemService(INPUT_SERVICE) as InputManager
+        selectedDescriptor = savedInstanceState?.getString("gamepad_descriptor")
+        content = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            val padding = (16 * resources.displayMetrics.density).toInt()
+            setPadding(padding, padding, padding, padding)
+        }
+        setContentView(ScrollView(this).apply { addView(content) })
+    }
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putString("gamepad_descriptor", selectedDescriptor)
+        super.onSaveInstanceState(outState)
+    }
+    override fun onResume() {
+        super.onResume()
+        inputManager.registerInputDeviceListener(this, Handler(Looper.getMainLooper()))
+        render()
+    }
+    override fun onPause() {
+        inputManager.unregisterInputDeviceListener(this)
+        capture = null
+        super.onPause()
+    }
+    override fun onInputDeviceAdded(deviceId: Int) = render()
+    override fun onInputDeviceRemoved(deviceId: Int) = render()
+    override fun onInputDeviceChanged(deviceId: Int) = render()
+
+    private fun render() {
+        content.removeAllViews()
+        content.addView(TextView(this).apply { setText(R.string.gamepad_mapping_help) })
+        val devices = InputDevice.getDeviceIds().mapNotNull { InputDevice.getDevice(it) }.filter { GamepadMapping.isGamepad(it) }
+        if(devices.isEmpty()) {
+            content.addView(TextView(this).apply { setText(R.string.gamepad_mapping_no_device) })
+            return
+        }
+        val selected = devices.find { it.descriptor == selectedDescriptor } ?: devices.first()
+        selectedDescriptor = selected.descriptor
+        content.addView(Button(this).apply {
+            text = getString(R.string.gamepad_mapping_device, selected.name)
+            setOnClickListener {
+                MaterialAlertDialogBuilder(this@GamepadSettingsActivity)
+                    .setTitle(R.string.gamepad_mapping_device_title)
+                    .setItems(devices.map { it.name }.toTypedArray()) { _, index ->
+                        selectedDescriptor = devices[index].descriptor
+                        render()
+                    }.show()
+            }
+        })
+        val mapping = GamepadMapping.load(preferences, selected.descriptor)
+        GamepadMapping.targets.forEach { (target, label) ->
+            val sources = mapping.filterValues { it == target }.keys
+            val targetLabel = if(target == "touchpad") getString(R.string.gamepad_mapping_touchpad_click) else label
+            content.addView(Button(this).apply {
+                isAllCaps = false
+                text = "$targetLabel: ${sources.joinToString(" / ") { GamepadMapping.sourceLabel(it) }.ifEmpty { getString(R.string.gamepad_mapping_unassigned) }}"
+                setOnClickListener { capture(selected, target, targetLabel) }
+            })
+        }
+        content.addView(Button(this).apply {
+            setText(R.string.gamepad_mapping_reset)
+            setOnClickListener {
+                MaterialAlertDialogBuilder(this@GamepadSettingsActivity)
+                    .setMessage(R.string.gamepad_mapping_reset_question)
+                    .setPositiveButton(android.R.string.ok) { _, _ ->
+                        preferences.setGamepadProfile(selected.descriptor, null); render()
+                    }.setNegativeButton(android.R.string.cancel, null).show()
+            }
+        })
+    }
+    private fun capture(device: InputDevice, target: String, label: String) {
+        val dialog = MaterialAlertDialogBuilder(this)
+            .setTitle(label)
+            .setMessage(R.string.gamepad_mapping_press)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setNeutralButton(R.string.gamepad_mapping_clear) { _, _ ->
+                GamepadMapping.save(preferences, device.descriptor,
+                    GamepadMapping.load(preferences, device.descriptor).filterValues { it != target })
+                render()
+            }.create()
+        neutralAxes.clear()
+        capture = { source ->
+            GamepadMapping.save(preferences, device.descriptor,
+                GamepadMapping.assign(GamepadMapping.load(preferences, device.descriptor), source, target))
+            capture = null
+            dialog.dismiss()
+            render()
+        }
+        dialog.setOnDismissListener { capture = null }
+        dialog.setOnKeyListener { _, _, event ->
+            if(event.device?.descriptor != device.descriptor) false
+            else {
+                if(event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0)
+                    capture?.invoke(GamepadMapping.key(event.keyCode))
+                true
+            }
+        }
+        dialog.show()
+        dialog.window?.decorView?.setOnGenericMotionListener { _, event ->
+            if(event.device?.descriptor != device.descriptor || !event.isFromSource(InputDevice.SOURCE_JOYSTICK)) false
+            else {
+                GamepadMapping.axes.forEach { axis ->
+                    val value = event.getAxisValue(axis)
+                    if(kotlin.math.abs(value) < 0.2f) neutralAxes.add(axis)
+                    if(kotlin.math.abs(value) > 0.7f && axis in neutralAxes && capture != null)
