+package com.metallic.chiaki.touchcontrols
+
+import android.view.MotionEvent
+import org.robolectric.RuntimeEnvironment
+import android.content.Context
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+class TouchInputTest {
+    private fun event(action: Int, x: Float = 10f) = MotionEvent.obtain(0, 0, action, x, 10f, 0)
+    @Test fun profilePersistsPerController() {
+        val context = RuntimeEnvironment.getApplication()
+        val prefs = com.metallic.chiaki.common.Preferences(context)
+        val mapping = mapOf("key:188" to "touchpad")
+        com.metallic.chiaki.session.GamepadMapping.save(prefs, "controller-one", mapping)
+        assertEquals(mapping, com.metallic.chiaki.session.GamepadMapping.load(
+            com.metallic.chiaki.common.Preferences(context), "controller-one"))
+        assertNotEquals(mapping, com.metallic.chiaki.session.GamepadMapping.load(prefs, "controller-two"))
+        prefs.setGamepadProfile("controller-one", null)
+        assertEquals(com.metallic.chiaki.session.GamepadMapping.defaults(prefs.swapCrossMoon),
+            com.metallic.chiaki.session.GamepadMapping.load(prefs, "controller-one"))
+    }
+    @Test fun cancelReleasesButton() {
+        val button = ButtonView(RuntimeEnvironment.getApplication())
+        button.layout(0, 0, 100, 100)
+        val states = mutableListOf<Boolean>()
+        button.buttonPressedCallback = { states.add(it) }
+        event(MotionEvent.ACTION_DOWN).also { button.onTouchEvent(it); it.recycle() }
+        assertTrue(button.buttonPressed)
+        event(MotionEvent.ACTION_CANCEL).also { button.onTouchEvent(it); it.recycle() }
+        assertFalse(button.buttonPressed)
+        assertEquals(listOf(true, false), states)
+    }
+    @Test fun cancelReleasesStickPointerAndAllowsNextTouch() {
+        val tracker = TouchTracker()
+        event(MotionEvent.ACTION_DOWN).also { tracker.touchEvent(it); it.recycle() }
+        assertNotNull(tracker.currentPosition)
+        event(MotionEvent.ACTION_CANCEL).also { tracker.touchEvent(it); it.recycle() }
+        assertNull(tracker.currentPosition)
+        event(MotionEvent.ACTION_DOWN, 20f).also { tracker.touchEvent(it); it.recycle() }
+        assertEquals(20f, tracker.currentPosition!!.x)
+    }
+    @Test fun touchpadPublishesIndependentSnapshotsAndResetsTouches() {
+        val touchpad = TouchpadView(RuntimeEnvironment.getApplication())
+        touchpad.layout(0, 0, 100, 100)
+        event(MotionEvent.ACTION_DOWN).also { touchpad.onTouchEvent(it); it.recycle() }
+        val first = touchpad.controllerState.value
+        val firstX = first.touches[0].x
+        event(MotionEvent.ACTION_MOVE, 50f).also { touchpad.onTouchEvent(it); it.recycle() }
+        val moved = touchpad.controllerState.value
+        assertEquals(firstX, first.touches[0].x)
+        assertNotEquals(firstX, moved.touches[0].x)
+        touchpad.resetInput()
+        assertTrue(touchpad.controllerState.value.touches.all { it.id < 0 })
+        assertEquals(0U, touchpad.controllerState.value.buttons)
+    }
+}
