+package com.metallic.chiaki.stream
+
+/** Full buttons and touchpad-only are mutually exclusive. Keep user choice on disconnect. */
+enum class TouchControlsMode {
+    HIDDEN, FULL, TOUCHPAD;
+    companion object {
+        fun select(full: Boolean, touchpad: Boolean, connected: Boolean, autoHide: Boolean) = when {
+            touchpad -> TOUCHPAD
+            full && !(connected && autoHide) -> FULL
+            else -> HIDDEN
+        }
+    }
+}
