@@ -0,0 +1,75 @@
+package com.metallic.chiaki.session
+
+import android.view.KeyEvent
+import android.view.MotionEvent
+import com.metallic.chiaki.lib.ControllerState
+import org.junit.Assert.*
+import org.junit.Test
+
+class GamepadMappingTest {
+    @Test fun everyPsButtonCanBeAssigned() {
+        for(target in GamepadMapping.targets.keys) {
+            val pad = GamepadState(mapOf(GamepadMapping.key(188) to target))
+            assertTrue(pad.key(188, true))
+            val pressed = pad.snapshot()
+            assertTrue(target, pressed.buttons != 0U || pressed.l2State > 0U || pressed.r2State > 0U)
+            pad.key(188, false)
+            assertEquals(ControllerState(), pad.snapshot())
+        }
+    }
+    @Test fun releasingOneSourceDoesNotReleaseAnother() {
+        val pad = GamepadState(mapOf(GamepadMapping.key(188) to "cross", GamepadMapping.key(189) to "cross"))
+        pad.key(188, true); pad.key(189, true); pad.key(188, false)
+        assertEquals(ControllerState.BUTTON_CROSS, pad.snapshot().buttons)
+        pad.key(189, false)
+        assertEquals(0U, pad.snapshot().buttons)
+    }
+    @Test fun digitalOnlyTriggerNotifiesOnPressAndRelease() {
+        val pad = GamepadState(GamepadMapping.defaults(false))
+        pad.key(KeyEvent.KEYCODE_BUTTON_L2, true)
+        assertEquals(255.toUByte(), pad.snapshot().l2State)
+        pad.key(KeyEvent.KEYCODE_BUTTON_L2, false)
+        assertEquals(0.toUByte(), pad.snapshot().l2State)
+    }
+    @Test fun analogTriggerPreservesMagnitudeDespiteDigitalEvent() {
+        val pad = GamepadState(GamepadMapping.defaults(false))
+        pad.key(KeyEvent.KEYCODE_BUTTON_L2, true)
+        pad.axis(MotionEvent.AXIS_LTRIGGER, 0.4f)
+        assertEquals(102.toUByte(), pad.snapshot().l2State)
+        pad.axis(MotionEvent.AXIS_LTRIGGER, 0f)
+        assertEquals(0.toUByte(), pad.snapshot().l2State)
+    }
+    @Test fun triggerRemapMovesBothRepresentations() {
+        val mapping = GamepadMapping.assign(GamepadMapping.defaults(false),
+            GamepadMapping.key(KeyEvent.KEYCODE_BUTTON_L2), "touchpad")
+        val pad = GamepadState(mapping)
+        pad.key(KeyEvent.KEYCODE_BUTTON_L2, true)
+        pad.axis(MotionEvent.AXIS_LTRIGGER, 0.8f)
+        assertEquals(ControllerState.BUTTON_TOUCHPAD, pad.snapshot().buttons)
+        assertEquals(0.toUByte(), pad.snapshot().l2State)
+    }
+    @Test fun dpadKeysAndAxesCanBeRemapped() {
+        val mapping = GamepadMapping.assign(GamepadMapping.defaults(false),
+            GamepadMapping.axis(MotionEvent.AXIS_HAT_X, -1), "ps")
+        val pad = GamepadState(mapping)
+        pad.axis(MotionEvent.AXIS_HAT_X, -1f)
+        assertEquals(ControllerState.BUTTON_PS, pad.snapshot().buttons)
+        pad.axis(MotionEvent.AXIS_HAT_X, 0f)
+        assertEquals(0U, pad.snapshot().buttons)
+        pad.key(KeyEvent.KEYCODE_DPAD_LEFT, true)
+        assertEquals(ControllerState.BUTTON_PS, pad.snapshot().buttons)
+    }
+    @Test fun customAssignmentReplacesTargetAndSourceWithoutAffectingOthers() {
+        val mapping = GamepadMapping.assign(GamepadMapping.defaults(false), GamepadMapping.key(KeyEvent.KEYCODE_BUTTON_A), "options")
+        val pad = GamepadState(mapping)
+        pad.key(KeyEvent.KEYCODE_BUTTON_A, true)
+        assertEquals(ControllerState.BUTTON_OPTIONS, pad.snapshot().buttons)
+        assertFalse(pad.key(KeyEvent.KEYCODE_BUTTON_START, true))
+    }
+    @Test fun touchAndGamepadButtonsMerge() {
+        val pad = GamepadState(GamepadMapping.defaults(false))
+        pad.key(KeyEvent.KEYCODE_BUTTON_A, true)
+        val state = pad.snapshot() or ControllerState(buttons = ControllerState.BUTTON_TOUCHPAD)
+        assertEquals(ControllerState.BUTTON_CROSS or ControllerState.BUTTON_TOUCHPAD, state.buttons)
+    }
+}
