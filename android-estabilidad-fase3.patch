  return -1; }
 media_status_t AMediaCodec_releaseOutputBuffer(AMediaCodec *c,size_t i,_Bool r) { (void)c;(void)i;if(r)atomic_fetch_add(&rendered_outputs,1);return 0; }
+media_status_t AMediaCodec_releaseOutputBufferAtTime(AMediaCodec *c,size_t i,int64_t target) {
+ uint64_t now=chiaki_time_now_monotonic_us()*1000;
+ assert(target>0 && (uint64_t)target<=now+33333334ULL);
+ return AMediaCodec_releaseOutputBuffer(c,i,true);
+}
+static void test_pacing(void) {
+ for(unsigned fps=30;fps<=60;fps+=30) {
+  uint64_t interval=1000000000ULL/fps, now=1000000000ULL;
+  AndroidVideoPacing p={0};bool rebased;
+  assert(android_video_pacing_target(&p,now,fps,&rebased)==now+interval && !rebased);
+  assert(android_video_pacing_target(&p,now,fps,&rebased)==now+2*interval);
+  assert(android_video_pacing_target(&p,now,fps,&rebased)==0);
+  now+=interval;
+  assert(android_video_pacing_target(&p,now,fps,&rebased)==now+2*interval);
+  now+=10*interval;
+  assert(android_video_pacing_target(&p,now,fps,&rebased)==now+interval && rebased);
+  for(int n=0;n<10000;n++) {
+   now+=interval;
+   uint64_t target=android_video_pacing_target(&p,now,fps,&rebased);
+   assert(target==now+interval && !rebased);
+  }
+ }
+}
 static void *check_unlocked(void *arg) { ChiakiMutex *m=arg;assert(chiaki_mutex_trylock(m)==CHIAKI_ERR_SUCCESS);chiaki_mutex_unlock(m);return NULL; }
 static void unlocked(ChiakiMutex *m) { ChiakiThread t;assert(chiaki_thread_create(&t,check_unlocked,m)==CHIAKI_ERR_SUCCESS);chiaki_thread_join(&t,NULL); }
 int main(void)
 {
+ test_pacing();
  ChiakiLog log;chiaki_log_init(&log,CHIAKI_LOG_ALL,capture_log,NULL);
  AndroidChiakiVideoDecoder v;
  assert(android_chiaki_video_decoder_init(&v,&log,1280,720,CHIAKI_CODEC_H264)==CHIAKI_ERR_SUCCESS);
