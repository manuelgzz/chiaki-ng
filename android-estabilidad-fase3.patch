diff --git a/android/app/src/main/cpp/video-pacing.h b/android/app/src/main/cpp/video-pacing.h
new file mode 100644
index 0000000..6d1b4b3
--- /dev/null
+++ b/android/app/src/main/cpp/video-pacing.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+#ifndef CHIAKI_ANDROID_VIDEO_PACING
+#define CHIAKI_ANDROID_VIDEO_PACING 1
+#endif
+// Monotonic nanoseconds; a bounded Surface schedule, not a network jitter buffer.
+typedef struct { uint64_t next_ns; } AndroidVideoPacing;
+static inline uint64_t android_video_pacing_target(AndroidVideoPacing *p,
+        uint64_t now_ns, unsigned fps, bool *rebased)
+{
+    if(fps != 30 && fps != 60) fps = 60;
+    const uint64_t interval = 1000000000ULL / fps;
+    *rebased = false;
+    if(!p->next_ns || p->next_ns < now_ns)
+    {
+        *rebased = p->next_ns != 0;
+        p->next_ns = now_ns + interval;
+    }
+    // Do not build an unbounded Surface queue if a burst outruns presentation.
+    if(p->next_ns > now_ns + 2 * interval) return 0;
+    uint64_t target = p->next_ns;
+    p->next_ns += interval;
+    return target;
+}
