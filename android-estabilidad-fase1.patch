+#!/usr/bin/env bash
+set -euo pipefail
+repo_dir=$(cd "$(dirname "$0")/.." && pwd)
+build_dir=$(mktemp -d)
+trap 'rm -rf "$build_dir"' EXIT
+cd "$repo_dir"
+${CC:-cc} -std=gnu11 -g -D__ANDROID_API__=24 \
+  -fsanitize=address,undefined -fno-omit-frame-pointer \
+  -Itest/android-stubs -Ilib/include \
+  test/android_decoder_lifecycle.c \
+  android/app/src/main/cpp/video-decoder.c \
+  android/app/src/main/cpp/audio-decoder.c \
+  lib/src/thread.c lib/src/time.c lib/src/log.c \
+  -pthread -o "$build_dir/android-lifecycle"
+ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 \
+  timeout 15 "$build_dir/android-lifecycle"

