+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdatomic.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <media/NdkMediaCodec.h>
+#include <android/native_window_jni.h>
+#include "../android/app/src/main/cpp/video-decoder.h"
+#include "../android/app/src/main/cpp/audio-decoder.h"
+struct AMediaCodec { atomic_int readers; uint8_t data[256]; };
+struct ANativeWindow { int unused; };
+static int windows, codecs;
+static int fail_input, fail_queue, fail_swap, fail_configure, fail_start;
+AMediaFormat *AMediaFormat_new(void) { return calloc(1,sizeof(AMediaFormat)); }
+void AMediaFormat_delete(AMediaFormat *f) { free(f); }
+void AMediaFormat_setString(AMediaFormat *f,const char *k,const char *v) { (void)f;(void)k;(void)v; }
+void AMediaFormat_setInt32(AMediaFormat *f,const char *k,int32_t v) { (void)f;(void)k;(void)v; }
+ANativeWindow *ANativeWindow_fromSurface(JNIEnv *e,jobject s) { (void)e;(void)s;windows++;return calloc(1,sizeof(ANativeWindow)); }
+void ANativeWindow_release(ANativeWindow *w) { assert(w);windows--;free(w); }
+AMediaCodec *AMediaCodec_createDecoderByType(const char *m) { (void)m;codecs++;return calloc(1,sizeof(AMediaCodec)); }
+media_status_t AMediaCodec_configure(AMediaCodec *c,const AMediaFormat *f,ANativeWindow *w,void *x,uint32_t a) { (void)c;(void)f;(void)w;(void)x;(void)a;return fail_configure ? -1:0; }
+media_status_t AMediaCodec_start(AMediaCodec *c) { (void)c;return fail_start ? -1:0; }
+media_status_t AMediaCodec_stop(AMediaCodec *c) { assert(!atomic_load(&c->readers));return 0; }
+media_status_t AMediaCodec_delete(AMediaCodec *c) { assert(!atomic_load(&c->readers));codecs--;free(c);return 0; }
+media_status_t AMediaCodec_setOutputSurface(AMediaCodec *c,ANativeWindow *w) { (void)c;(void)w;return fail_swap ? -1:0; }
+ssize_t AMediaCodec_dequeueInputBuffer(AMediaCodec *c,int64_t t) { (void)c;(void)t;return fail_input ? -1:0; }
+uint8_t *AMediaCodec_getInputBuffer(AMediaCodec *c,size_t i,size_t *s) { (void)i;*s=sizeof(c->data);return c->data; }
+uint8_t *AMediaCodec_getOutputBuffer(AMediaCodec *c,size_t i,size_t *s) { return AMediaCodec_getInputBuffer(c,i,s); }
+media_status_t AMediaCodec_queueInputBuffer(AMediaCodec *c,size_t i,off_t o,size_t s,uint64_t t,uint32_t f) { (void)c;(void)i;(void)o;(void)s;(void)t;(void)f;return fail_queue ? -1:0; }
+ssize_t AMediaCodec_dequeueOutputBuffer(AMediaCodec *c,AMediaCodecBufferInfo *i,int64_t t) { (void)i;assert(t>=0);atomic_fetch_add(&c->readers,1);usleep(1000);atomic_fetch_sub(&c->readers,1);return -1; }
+media_status_t AMediaCodec_releaseOutputBuffer(AMediaCodec *c,size_t i,_Bool r) { (void)c;(void)i;(void)r;return 0; }
+static void *check_unlocked(void *arg) { ChiakiMutex *m=arg;assert(chiaki_mutex_trylock(m)==CHIAKI_ERR_SUCCESS);chiaki_mutex_unlock(m);return NULL; }
+static void unlocked(ChiakiMutex *m) { ChiakiThread t;assert(chiaki_thread_create(&t,check_unlocked,m)==CHIAKI_ERR_SUCCESS);chiaki_thread_join(&t,NULL); }
+int main(void)
+{
+ ChiakiLog log;chiaki_log_init(&log,0,NULL,NULL);
+ AndroidChiakiVideoDecoder v;
+ assert(android_chiaki_video_decoder_init(&v,&log,1280,720,CHIAKI_CODEC_H264)==CHIAKI_ERR_SUCCESS);
+ uint8_t sample[4]={0};
+ assert(!android_chiaki_video_decoder_video_sample(sample,sizeof(sample),0,false,&v));
+ android_chiaki_video_decoder_set_surface(&v,NULL,NULL);unlocked(&v.codec_mutex);
+ for(int n=0;n<30;n++) {
+  android_chiaki_video_decoder_set_surface(&v,NULL,(jobject)1);
+  usleep(2000);
+  assert(android_chiaki_video_decoder_video_sample(sample,sizeof(sample),0,false,&v));
+  fail_input=1;assert(!android_chiaki_video_decoder_video_sample(sample,sizeof(sample),0,false,&v));fail_input=0;
+  fail_queue=1;assert(!android_chiaki_video_decoder_video_sample(sample,sizeof(sample),0,false,&v));fail_queue=0;
+  ANativeWindow *old=v.window;fail_swap=1;
+  android_chiaki_video_decoder_set_surface(&v,NULL,(jobject)1);assert(v.window==old && windows==1);fail_swap=0;
+  android_chiaki_video_decoder_set_surface(&v,NULL,NULL);unlocked(&v.codec_mutex);
+  assert(!v.codec && !v.window && !v.output_thread_started);assert(codecs==0 && windows==0);
+ }
+ android_chiaki_video_decoder_fini(&v);
