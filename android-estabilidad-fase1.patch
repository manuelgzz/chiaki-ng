+ a.codec=AMediaCodec_createDecoderByType("audio/opus");
+ ChiakiAudioSink sink;android_chiaki_audio_decoder_get_sink(&a,&sink);
+ fail_input=1;sink.frame_cb(sample,sizeof(sample),sink.user);unlocked(&a.codec_mutex);fail_input=0;
+ AMediaCodec_delete(a.codec);a.codec=NULL;android_chiaki_audio_decoder_fini(&a);
+ for(int n=0;n<30;n++) {
+  android_chiaki_audio_decoder_init(&a,&log);
+  android_chiaki_audio_decoder_get_sink(&a,&sink);
+  ChiakiAudioHeader header={0};header.channels=2;header.rate=48000;
+  sink.header_cb(&header,sink.user);usleep(2000);
+  sink.header_cb(&header,sink.user);usleep(2000);
+  android_chiaki_audio_decoder_fini(&a);assert(codecs==0);
+ }
+ for(int failure=0;failure<2;failure++) {
+  android_chiaki_audio_decoder_init(&a,&log);android_chiaki_audio_decoder_get_sink(&a,&sink);
+  fail_configure=failure==0;fail_start=failure==1;
+  ChiakiAudioHeader header={0};header.channels=2;header.rate=48000;
+  sink.header_cb(&header,sink.user);assert(!a.codec && !a.output_thread_started);
+  unlocked(&a.codec_mutex);android_chiaki_audio_decoder_fini(&a);
+  fail_configure=fail_start=0;assert(codecs==0);
+ }
+ puts("PASS: 30 video cycles, 30 audio reconfiguration cycles, input/queue/surface/configure/start errors, cross-thread unlock and resource balance");
+ return 0;
+}
